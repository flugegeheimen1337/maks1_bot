# Токен от @BotFather
BOT_TOKEN=

# Redis хранит незавершённую анкету 24 часа
REDIS_URL=redis://localhost:6379/0

# Заявки, статусы, журнал и метрики
DATABASE_PATH=data/praktika.sqlite

# Закрытый чат, куда падают новые заявки. ID группы обычно отрицательный.
APPLICATIONS_CHAT_ID=

# Полный доступ: просмотр, статусы, CSV, удаление. Через запятую.
ADMIN_IDS=

# Только просмотр и смена статуса.
OPERATOR_IDS=

# Текст согласия. Пока пусто, на экране остаются плейсхолдеры [ФИО], [номер], [почта].
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_EMAIL=

# Ссылка на тот же текст согласия (Telegraph или страница сайта).
PRIVACY_URL=

# Подставляется в финальный экран: «В течение …»
RESPONSE_TIME=рабочего дня

# Часовой пояс в карточке куратора
CURATOR_TZ=Europe/Moscow
